{
  "version": "4.0.0-0",
  "name": "react-image-turntable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdyman/react-image-turntable.git",
    "directory": "lib"
  },
  "homepage": "https://react-image-turntable.vercel.app",
  "author": {
    "email": "averynerdyman@gmail.com",
    "name": "nerdyman",
    "url": "https://github.com/nerdyman"
  },
  "description": "Display a set of images as a draggable 360 degree turntable.",
  "keywords": ["react", "image", "360", "turntable", "rotator", "slider"],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "import": "./dist/index.cjs"
      }
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "start": "concurrently -k -s first -n \"tsdown,ts\" -c \"blue,cyan\" \"tsdown --watch\" \"pnpm run check --watch --preserveWatchOutput\"",
    "build": "pnpm run check && NODE_ENV=production tsdown",
    "release": "pnpm run release:preflight && pnpm run release:publish",
    "release:preflight": "cp ../README.md ../LICENSE . && pnpm run -w lint && pnpm run -w test --run && pnpm run build && pnpm run check",
    "release:publish": "release-it",
    "check": "tsc --noEmit"
  },
  "browserslist": ["defaults and fully supports es6-module", "maintained node versions", "ios >= 16.6"],
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.4",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "release-it": "^20.2.1",
    "tsdown": "^0.22.3",
    "tslib": "~2.8.1",
    "typescript": "^5.6.2"
  }
}
